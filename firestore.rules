rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only authenticated users (admins) can write content.
    // Public site content must be readable by all visitors.
    
    match /cases/{caseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /site_settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /site_blocks/{blockId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /backstage/{backstageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    
    // Default fallback: requires auth
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

